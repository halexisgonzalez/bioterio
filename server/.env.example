# Copiá este archivo como ".env" (misma carpeta) y completá tus datos.
# ".env" está en .gitignore: nunca se sube al repositorio.

# --- Nodos a monitorear ---
# Formato: "<node_id>=<host>,<node_id>=<host>,..."
# host puede ser una IP o el nombre mDNS del nodo (ej: jaula_01.local)
BIOTERIO_NODES=jaula_01=192.168.0.160

# --- Zonas de interés por nodo (opcional) ---
# Formato: "<node_id>:<etiqueta>:<x1>,<y1>,<x2>,<y2>;<node_id>:<etiqueta>:..."
# Coordenadas en píxeles sobre el frame del nodo (640x480 en VGA).
# Ejemplo: BIOTERIO_ZONES=jaula_01:comedero:0,0,120,90;jaula_01:casa:420,300,640,480
BIOTERIO_ZONES=

# --- MySQL (coincide con los defaults de docker-compose.yml) ---
# Puerto 3307 porque docker-compose.yml mapea ahí para no chocar con un
# MySQL local en 3306. Si usás tu propio MySQL en vez de Docker, poné 3306
# (o el que corresponda) y creá la base/usuario a mano con schema.sql.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=bioterio
MYSQL_PASSWORD=bioterio
MYSQL_DATABASE=bioterio

# --- Muestreo y persistencia ---
# Cada cuánto se toma una muestra de posición por track (segundos)
SAMPLE_INTERVAL_S=0.5
# Cada cuánto se escribe a MySQL el lote acumulado (segundos)
BATCH_FLUSH_INTERVAL_S=10
# Desplazamiento mínimo entre muestras para considerar "en movimiento" (píxeles)
MOVEMENT_THRESHOLD_PX=4
# Cuadros sin detección antes de dar por perdido un track
MAX_DISAPPEARED_FRAMES=30

# --- Detector ---
# "background_subtraction" (default, sin modelo entrenado, ver limitaciones
# en el README) o "yolo" (requiere un modelo — ver YOLO_MODEL_PATH abajo).
DETECTOR_BACKEND=background_subtraction

# Solo aplica si DETECTOR_BACKEND=yolo. Un nombre conocido de ultralytics
# (ej. "yolo11n.pt") se descarga solo la primera vez; para un modelo propio,
# poné la ruta al archivo .pt.
YOLO_MODEL_PATH=yolo11n.pt
YOLO_CONFIDENCE=0.4
# Clases a quedarse, separadas por coma (ej. "mouse,rat"). Vacío = todas las
# clases que reconozca el modelo (útil para probar qué detecta un modelo
# generico de COCO, que no tiene clase "ratón").
YOLO_CLASSES=
